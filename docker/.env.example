# Copy to docker/.env (mode 600) on the host that runs compose.yaml.
# The hostname devices reach the app at; Caddy issues its certificate for it.
# SITE_ADDRESS=localhost
# Pin both images to a revision whose CI image jobs succeeded.
# IMAGE_TAG=sha-<short commit>
# LOG_LEVEL=info
# Host folder for the nightly VACUUM INTO snapshots; relative to this file.
# SNAPSHOT_DIR=./snapshots
